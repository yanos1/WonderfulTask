# Copy to .env and fill in. Either key is optional — without one, the app runs in
# deterministic-fallback mode (keyword routing + templated answers).

# Google AI Studio (free tier, no billing): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (optional second provider): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# AeroDataBox via RapidAPI (optional live delays/flights garnish)
AERODATABOX_API_KEY=
